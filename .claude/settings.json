{
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go run ./cmd/*)",
      "Bash(gofmt *)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(npx prettier *)",
      "Bash(npx prettier@3.3.3 *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git merge *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create --draft *)",
      "Bash(gh repo view *)",
      "Bash(command ls *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(head *)",
      "Bash(tail *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.sh",
            "timeout": 120,
            "statusMessage": "Formatting and linting..."
          }
        ]
      }
    ]
  }
}
